# Desktop/headless-host MK3: device access for plugdev without a seat login,
# a stable /dev/maschine-mk3 link, and hotplug start of the user service
# machinista.service (see tools/install_desktop_service.sh). The service binds
# to dev-maschine\x2dmk3.device, so unplugging the MK3 stops it.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="1600", GROUP="plugdev", MODE="0660"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="17cc", ATTR{idProduct}=="1600", GROUP="plugdev", MODE="0660", SYMLINK+="maschine-mk3", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="machinista.service"
